Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (live /joint_states)
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Alpha: 1
      Value: true
    - Class: moveit_rviz_plugin/Trajectory
      Name: Rencana (display_planned_path)
      Robot Description: robot_description
      Trajectory Topic: /display_planned_path
      Loop Animation: false
      State Display Time: 0.05 s
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Demo zona (biru zona, hijau botol terkoreksi, merah mentah, kuning p_cmd)
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /demo_zone/markers
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Env map (D455 voxels, g34n)
      Color Transformer: AxisColor
      Axis: Z
      Style: Points
      Size (Pixels): 3
      Alpha: 0.5
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /env_static_map/cloud
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: rgbd2 deteksi YOLOE (seg/debug_image)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rgbd2/seg/debug_image
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Focal Point:
        X: 1.75
        Y: 0.55
        Z: 1.1
      Name: Current View
      Pitch: 0.55
      Target Frame: world
      Yaw: -2.4
Window Geometry:
  Height: 975
  Width: 1400
