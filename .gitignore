# ROS 2 build artifacts
build/
install/
log/

# Python cache
**/__pycache__/
*.pyc
*.pyo

# VSCode or IDE configs
.vscode/
.idea/

# Other temp files
*.swp
*~

# Large personal binaries (keep on disk, out of git history)
nando-Thesis_01.pdf

# LaTeX build artifacts (commit the .tex source, not the compiled output)
docs/IEEE-conference-Energy_Aware/energy_aware_selection.pdf
docs/IEEE-conference-Energy_Aware/*.aux
docs/IEEE-conference-Energy_Aware/*.log
docs/IEEE-conference-Energy_Aware/*.out
docs/IEEE-conference-Energy_Aware/*.synctex.gz
docs/IEEE-conference-Energy_Aware/*.fdb_latexmk
docs/IEEE-conference-Energy_Aware/*.fls

# Model weights (multi-hundred-MB, download/derive instead of versioning)
ros2_ws/src/reachability_gng/*.pt
ros2_ws/src/reachability_gng/*.ts

# Regenerable FK sample datasets (~10 MB each, rebuilt by build_maps.sh);
# the trained GNG models (arm*_model.npz) ARE tracked.
data/maps/*_dataset.npz

# Poster LaTeX build artifacts (the poster PDF itself IS tracked)
docs/poster_A1_energy_aware/*.aux
docs/poster_A1_energy_aware/*.log
docs/poster_A1_energy_aware/*.out
docs/poster_A1_energy_aware/*.synctex.gz
docs/poster_A1_energy_aware/*.fdb_latexmk
docs/poster_A1_energy_aware/*.fls

# Archived full-length paper build output
docs/IEEE-conference-Energy_Aware/energy_aware_selection_full.pdf
