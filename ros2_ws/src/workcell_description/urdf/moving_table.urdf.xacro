<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== MATERIALS ========== -->
  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <!-- ========== MACRO: MOVING TABLE ========== -->
  <xacro:macro name="moving_table" params="prefix parent *origin">

    <!-- Base -->
    <link name="${prefix}base_link"/>
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Platform -->
    <link name="${prefix}platform_link">
      <visual>
        <geometry><box size="0.35 0.34 0.065"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><box size="0.35 0.34 0.065"/></geometry>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <inertia ixx="${5.0/12.0 * (0.34*0.34 + 0.065*0.065)}"
                 iyy="${5.0/12.0 * (0.35*0.35 + 0.065*0.065)}"
                 izz="${5.0/12.0 * (0.35*0.35 + 0.34*0.34)}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Linear slide -->
    <joint name="${prefix}linear_joint" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}platform_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="3.0" effort="1000" velocity="0.5"/>
    </joint>

    <!-- Rotation bar -->
    <link name="${prefix}rotation_link">
      <visual>
        <geometry><box size="0.08 0.8 0.015"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.08 0.8 0.015"/></geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <inertia ixx="${3.0/12.0*(0.8*0.8 + 0.015*0.015)}"
                 iyy="${3.0/12.0*(0.08*0.08 + 0.015*0.015)}"
                 izz="${3.0/12.0*(0.08*0.08 + 0.8*0.8)}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Fixed rotation joint (no flicker) -->
    <!-- <joint name="${prefix}rotation_joint" type="fixed">
      <parent link="${prefix}platform_link"/>
      <child link="${prefix}rotation_link"/>
      <origin xyz="0 0 -${0.065/2 + 0.015/2}" rpy="0 0 ${pi/2}"/>
    </joint> -->

    <!-- Rotating joint (instead of fixed) -->
    <joint name="${prefix}rotation_joint" type="revolute">
      <parent link="${prefix}platform_link"/>
      <child link="${prefix}rotation_link"/>
      <origin xyz="0 0 -${0.065/2 + 0.015/2}" rpy="0 0 ${pi/2}"/> <!-- default 90° -->
      <axis xyz="0 0 1"/> <!-- rotate around Z -->
      <limit lower="${-pi}" upper="${pi}" effort="10" velocity="1.0"/> <!-- ±180° travel -->
    </joint>

    <!-- ========== Mount plates (Arm attachment points) ========== -->
    <xacro:property name="mount_plate_radius" value="${0.055}"/> <!-- 11cm diameter -->
    <xacro:property name="mount_plate_length" value="0.05"/>
    <xacro:property name="mount_plate_mass" value="0.2"/>
    <xacro:property name="mount_plate_z_offset_on_link" value="-${0.015/2 + 0.05/2}"/>
    <xacro:property name="mount_plate_y_offset" value="0.4"/>

    <!-- Left plate -->
    <link name="${prefix}mount_plate_left">
      <visual>
        <geometry><cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mount_plate_mass}"/>
        <inertia ixx="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}"
                 iyy="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}"
                 izz="${mount_plate_mass/2.0*mount_plate_radius*mount_plate_radius}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}mount_plate_left_joint" type="fixed">
      <parent link="${prefix}rotation_link"/>
      <child link="${prefix}mount_plate_left"/>
      <origin xyz="0 ${mount_plate_y_offset} ${mount_plate_z_offset_on_link}" rpy="0 0 0"/>
    </joint>

    <!-- Right plate -->
    <link name="${prefix}mount_plate_right">
      <visual>
        <geometry><cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mount_plate_mass}"/>
        <inertia ixx="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}"
                 iyy="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}"
                 izz="${mount_plate_mass/2.0*mount_plate_radius*mount_plate_radius}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}mount_plate_right_joint" type="fixed">
      <parent link="${prefix}rotation_link"/>
      <child link="${prefix}mount_plate_right"/>
      <origin xyz="0 -${mount_plate_y_offset} ${mount_plate_z_offset_on_link}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
