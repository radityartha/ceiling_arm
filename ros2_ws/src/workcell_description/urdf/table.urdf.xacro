<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define some basic materials -->
  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="dark_grey">
      <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
   <material name="black">
      <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Macro for a single moving table unit -->
  <xacro:macro name="moving_table" params="prefix parent *origin">

    <!-- Fixed base attached to the ceiling/world -->
    <link name="${prefix}base_link"/>
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Moving platform (The main box) -->
    <link name="${prefix}platform_link">
       <visual>
         <geometry>
           <box size="0.35 0.34 0.065"/> <!-- 35cm x 34cm x 6.5cm box -->
         </geometry>
         <material name="grey"/>
         <origin xyz="0 0 0" rpy="0 0 0"/>
       </visual>
       <collision>
          <geometry>
            <box size="0.35 0.34 0.065"/>
          </geometry>
          <origin xyz="0 0 0" rpy="0 0 0"/>
       </collision>
       <inertial>
         <mass value="5.0"/> <!-- Example mass: 5 kg -->
         <origin xyz="0 0 0" rpy="0 0 0"/>
         <inertia ixx="${5.0/12.0 * (0.34*0.34 + 0.065*0.065)}" ixy="0.0" ixz="0.0"
                  iyy="${5.0/12.0 * (0.35*0.35 + 0.065*0.065)}" iyz="0.0"
                  izz="${5.0/12.0 * (0.35*0.35 + 0.34*0.34)}"/>
       </inertial>
    </link>

    <!-- Linear joint for the platform -->
    <joint name="${prefix}linear_joint" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}platform_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/> <!-- Moves along the X axis -->
      <limit lower="-1.5" upper="1.5" effort="1000" velocity="0.5"/>
    </joint>

    <!-- Rotating part (A bar, 80cm long [Y], 8cm wide [X], 8cm thick [Z]) -->
    <link name="${prefix}rotation_link">
       <visual>
         <geometry>
           <!-- 8cm wide (X), 80cm long (Y), 8cm thick (Z) -->
           <box size="0.08 0.8 0.008"/>
         </geometry>
         <material name="dark_grey"/>
         <!-- Positioned at the center, vertically on top of the platform -->
         <origin xyz="0 0 ${0.065/2 + 0.08/2}" rpy="0 0 0"/>
       </visual>
       <collision>
          <geometry>
           <box size="0.08 0.8 0.08"/>
          </geometry>
          <!-- Positioned at the center, vertically on top of the platform -->
          <origin xyz="0 0 ${0.065/2 + 0.08/2}" rpy="0 0 0"/>
       </collision>
        <inertial>
         <mass value="3.0"/> <!-- Example mass: 3 kg -->
         <!-- Origin relative to link frame (center of the box) -->
         <origin xyz="0 0 ${0.065/2 + 0.08/2}" rpy="0 0 0"/>
         <!-- Inertia tensor for a box -->
         <inertia ixx="${3.0/12.0*(0.8*0.8 + 0.08*0.08)}" ixy="0.0" ixz="0.0"
                  iyy="${3.0/12.0*(0.08*0.08 + 0.08*0.08)}" iyz="0.0"
                  izz="${3.0/12.0*(0.08*0.08 + 0.8*0.8)}"/>
       </inertial>
    </link>

    <!-- Rotation joint for the bar -->
    <joint name="${prefix}rotation_joint" type="revolute">
       <parent link="${prefix}platform_link"/>
       <child link="${prefix}rotation_link"/>
       <!-- Joint is centered on the platform, positioned at its top surface -->
       <origin xyz="0 0 ${0.065/2}" rpy="0 0 0"/>
       <axis xyz="0 0 1"/> <!-- Rotates around the Z axis (up/down) -->
       <limit lower="-3.14159" upper="3.14159" effort="500" velocity="1.0"/>
    </joint>

    <!-- === Arm Mounting Plates === -->
    <xacro:property name="mount_plate_radius" value="${11.0 / 2 / 100.0}"/> <!-- 5.5cm radius -->
    <xacro:property name="mount_plate_length" value="0.01"/> <!-- 1cm thick plate -->
    <!-- Z center of plate, relative to the Z center of the rotation_link -->
    <xacro:property name="mount_plate_z_offset_on_link" value="${0.08/2 + 0.01/2}"/> <!-- Z origin = LinkHalfHeight + PlateHalfHeight -->
    <xacro:property name="mount_plate_y_offset" value="0.4"/> <!-- 40cm left/right (at the tips) -->
    <xacro:property name="mount_plate_mass" value="0.2"/> <!-- Example mass 200g -->

    <!-- Left Mounting Plate -->
    <link name="${prefix}mount_plate_left">
        <visual>
            <geometry> <cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/> </geometry>
            <material name="black"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
             <geometry> <cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/> </geometry>
             <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <inertial>
             <mass value="${mount_plate_mass}"/>
             <origin xyz="0 0 0" rpy="0 0 0"/>
             <inertia ixx="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}" ixy="0.0" ixz="0.0"
                      iyy="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}" iyz="0.0"
                      izz="${mount_plate_mass/2.0*mount_plate_radius*mount_plate_radius}"/>
        </inertial>
    </link>
    <joint name="${prefix}mount_joint_left" type="fixed">
        <parent link="${prefix}rotation_link"/>
        <child link="${prefix}mount_plate_left"/>
        <!-- Place at +Y tip, on top of the rotation link -->
        <origin xyz="0 ${mount_plate_y_offset} ${mount_plate_z_offset_on_link}" rpy="0 0 0"/>
    </joint>

    <!-- Right Mounting Plate -->
    <link name="${prefix}mount_plate_right">
        <visual>
            <geometry> <cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/> </geometry>
            <material name="black"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
             <geometry> <cylinder radius="${mount_plate_radius}" length="${mount_plate_length}"/> </geometry>
             <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
         <inertial>
             <mass value="${mount_plate_mass}"/>
             <origin xyz="0 0 0" rpy="0 0 0"/>
             <inertia ixx="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}" ixy="0.0" ixz="0.0"
                      iyy="${mount_plate_mass/12.0*(3*mount_plate_radius*mount_plate_radius + mount_plate_length*mount_plate_length)}" iyz="0.0"
                      izz="${mount_plate_mass/2.0*mount_plate_radius*mount_plate_radius}"/>
        </inertial>
    </link>
    <joint name="${prefix}mount_joint_right" type="fixed">
        <parent link="${prefix}rotation_link"/>
        <child link="${prefix}mount_plate_right"/>
        <!-- Place at -Y tip, on top of the rotation link -->
        <origin xyz="0 -${mount_plate_y_offset} ${mount_plate_z_offset_on_link}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>