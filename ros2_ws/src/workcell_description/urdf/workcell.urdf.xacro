<?xml version="1.0"?>
<robot name="trailer_workcell"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- Configurable parameters                                       -->
  <!-- Set use_fake_hardware:=false and real IPs for real hardware   -->
  <!-- ============================================================ -->
  <xacro:arg name="use_fake_hardware" default="true"/>
  <!-- sim_isaac: when true, each arm/gripper uses topic_based_ros2_control
       (/isaac_joint_commands, /isaac_joint_states) for NVIDIA Isaac Sim. -->
  <xacro:arg name="sim_isaac"         default="false"/>
  <xacro:arg name="arm1_ip"           default="0.0.0.0"/>
  <xacro:arg name="arm2_ip"           default="0.0.0.0"/>
  <xacro:arg name="arm3_ip"           default="0.0.0.0"/>
  <xacro:arg name="arm4_ip"           default="0.0.0.0"/>
  <!-- Per-arm mock override: default to the global flag, but each arm can be
       mocked independently (e.g. mock an unreachable/powered-off arm so the
       real ones still come up instead of the whole ros2_control_node aborting). -->
  <xacro:arg name="arm1_fake"         default="$(arg use_fake_hardware)"/>
  <xacro:arg name="arm2_fake"         default="$(arg use_fake_hardware)"/>
  <xacro:arg name="arm3_fake"         default="$(arg use_fake_hardware)"/>
  <xacro:arg name="arm4_fake"         default="$(arg use_fake_hardware)"/>

  <!-- ============================ -->
  <!-- Include table and Kinova URDF -->
  <!-- ============================ -->

  <!-- Moving table definition -->
  <xacro:include filename="$(find workcell_description)/urdf/moving_table.urdf.xacro"/>

  <!-- Kinova Gen3 Lite (6DOF) arm and control macros -->
  <!-- <xacro:include filename="$(find kortex_description)/arms/gen3_lite/6dof/urdf/gen3_lite_macro.xacro"/> -->
  <!-- <xacro:include filename="$(find kortex_description)/arms/gen3_lite/6dof/urdf/gen3_lite_transmission_macro.xacro"/> -->
  <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro"/>
  <xacro:include filename="$(find kortex_description)/arms/gen3_lite/6dof/urdf/kortex.ros2_control.xacro"/>

  <!-- *** FIX: ADDED THIS LINE TO LOAD THE GRIPPER *** -->
  <!-- Kinova Gen3 Lite gripper (2F) -->
  <xacro:include filename="$(find kortex_description)/grippers/gen3_lite_2f/urdf/gen3_lite_2f_macro.xacro"/>
  <xacro:include filename="$(find kortex_description)/grippers/gen3_lite_2f/urdf/gen3_lite_2f_transmission_macro.xacro"/>

  <!-- ==================================== -->
  <!-- Base frame -->
  <!-- ==================================== -->
  <link name="world"/>

  <!-- ==================================== -->
  <!-- Moving Tables -->
  <!-- ==================================== -->

  <!-- Table 1 -->
  <xacro:moving_table prefix="t1_" parent="world">
    <origin xyz="0 0.36 2.05" rpy="0 0 0"/>
  </xacro:moving_table>

  <!-- Table 2 -->
  <xacro:moving_table prefix="t2_" parent="world">
    <origin xyz="0 -0.36 2.05" rpy="0 0 0"/>
  </xacro:moving_table>

  <!-- ==================================== -->
  <!-- Moving Tables Fake Hardware -->
  <!-- ==================================== -->

  <!-- Only mock the table joints in fully-fake mode. On real hardware the table
       joint states are owned and published by dual_table_controller (Modbus) on
       /joint_states; a mock ros2_control system here would have joint_state_
       broadcaster ALSO publish these joints as a constant 0, racing the real
       values at ~5:1 and making the HUD / sequence _wait_for_table read 0. -->
  <xacro:if value="$(arg use_fake_hardware)">
    <ros2_control name="TableFakeHardware" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>

      <joint name="t1_linear_joint">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>
      <joint name="t1_rotation_joint">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>

      <joint name="t2_linear_joint">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>
      <joint name="t2_rotation_joint">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>
    </ros2_control>
  </xacro:if>

  <!-- Isaac Sim: drive the table joints through topic_based_ros2_control so they
       move in the simulation (same /isaac_joint_* topics as the arms). -->
  <xacro:if value="$(arg sim_isaac)">
    <ros2_control name="TableTopicBased" type="system">
      <hardware>
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <!-- Dedicated command topic so the table is NOT starved by the arm/gripper
             flood on /isaac_joint_commands (the bridge has a separate subscriber
             for this). States stay on the shared /isaac_joint_states (single
             publisher = Isaac, no contention). -->
        <param name="joint_commands_topic">/isaac_table_commands</param>
        <param name="joint_states_topic">/isaac_joint_states</param>
      </hardware>
      <joint name="t1_linear_joint">
        <command_interface name="position" />
        <state_interface name="position" /><state_interface name="velocity" />
      </joint>
      <joint name="t1_rotation_joint">
        <command_interface name="position" />
        <state_interface name="position" /><state_interface name="velocity" />
      </joint>
      <joint name="t2_linear_joint">
        <command_interface name="position" />
        <state_interface name="position" /><state_interface name="velocity" />
      </joint>
      <joint name="t2_rotation_joint">
        <command_interface name="position" />
        <state_interface name="position" /><state_interface name="velocity" />
      </joint>
    </ros2_control>
  </xacro:if>

  <!-- ==================================== -->
  <!-- Arms Mounted on Table 1 -->
  <!-- ==================================== -->

  <!-- Arm 1 (t1_a1) — on table-1 RIGHT plate (left/right swapped to match real cell) -->
  <xacro:load_robot prefix="t1_a1_" parent="t1_mount_plate_right" arm="gen3_lite" dof="6" sim_isaac="$(arg sim_isaac)" gripper="gen3_lite_2f" gripper_joint_name="right_finger_bottom_joint" use_fake_hardware="$(arg arm1_fake)" use_internal_bus_gripper_comm="true" gripper_max_velocity="100.0" gripper_max_force="100.0" vision="false" robot_ip="$(arg arm1_ip)" username="admin" password="admin" port="10000" port_realtime="10001" session_inactivity_timeout_ms="60000" connection_inactivity_timeout_ms="2000">
    <origin xyz="0 0 -0.025" rpy="3.14159 0 -1.5707963267948966"/>
  </xacro:load_robot>

  <!-- Arm 2 (t1_a2) — on table-1 LEFT plate (left/right swapped to match real cell) -->
  <xacro:load_robot prefix="t1_a2_" parent="t1_mount_plate_left" arm="gen3_lite" dof="6" sim_isaac="$(arg sim_isaac)" gripper="gen3_lite_2f" gripper_joint_name="right_finger_bottom_joint" use_fake_hardware="$(arg arm2_fake)" use_internal_bus_gripper_comm="true" gripper_max_velocity="100.0" gripper_max_force="100.0" vision="false" robot_ip="$(arg arm2_ip)" username="admin" password="admin" port="10000" port_realtime="10001" session_inactivity_timeout_ms="60000" connection_inactivity_timeout_ms="2000">
    <origin xyz="0 0 -0.025" rpy="3.14159 0 1.5707963267948966"/>
  </xacro:load_robot>

  <!-- ==================================== -->
  <!-- Arms Mounted on Table 2 -->
  <!-- ==================================== -->

  <!-- Arm 3 (t2_a1) — on table-2 RIGHT plate (left/right swapped to match real cell) -->
  <xacro:load_robot prefix="t2_a1_" parent="t2_mount_plate_right" arm="gen3_lite" dof="6" sim_isaac="$(arg sim_isaac)" gripper="gen3_lite_2f" gripper_joint_name="right_finger_bottom_joint" use_fake_hardware="$(arg arm3_fake)" use_internal_bus_gripper_comm="true" gripper_max_velocity="100.0" gripper_max_force="100.0" vision="false" robot_ip="$(arg arm3_ip)" username="admin" password="admin" port="10000" port_realtime="10001" session_inactivity_timeout_ms="60000" connection_inactivity_timeout_ms="2000">
    <origin xyz="0 0 -0.025" rpy="3.14159 0 -1.5707963267948966"/>
  </xacro:load_robot>

  <!-- Arm 4 (t2_a2) — on table-2 LEFT plate (left/right swapped to match real cell) -->
  <xacro:load_robot prefix="t2_a2_" parent="t2_mount_plate_left" arm="gen3_lite" dof="6" sim_isaac="$(arg sim_isaac)" gripper="gen3_lite_2f" gripper_joint_name="right_finger_bottom_joint" use_fake_hardware="$(arg arm4_fake)" use_internal_bus_gripper_comm="true" gripper_max_velocity="100.0" gripper_max_force="100.0" vision="false" robot_ip="$(arg arm4_ip)" username="admin" password="admin" port="10000" port_realtime="10001" session_inactivity_timeout_ms="60000" connection_inactivity_timeout_ms="2000">
    <origin xyz="0 0 -0.025" rpy="3.14159 0 1.5707963267948966"/>
  </xacro:load_robot>

</robot>