<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachability_gng_interfaces</name>
  <version>0.0.0</version>
  <description>Service definitions for reachability_gng. Split out because
    reachability_gng is an ament_python package and cannot generate interfaces
    itself -- same split as moving_table_pkg / moving_table_interfaces.</description>
  <maintainer email="raditya.artha@gmail.com">radityartha</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
