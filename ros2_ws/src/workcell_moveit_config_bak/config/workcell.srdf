<robot name="trailer_workcell">

  <!-- Virtual joint -->
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="t1_base_link"/>

  <!-- Planning Groups -->
  <group name="t1_a1_arm">
    <chain base_link="t1_a1_base_link" tip_link="t1_a1_wrist_3_link"/>
  </group>
  <group name="t1_a2_arm">
    <chain base_link="t1_a2_base_link" tip_link="t1_a2_wrist_3_link"/>
  </group>
  <group name="t2_a1_arm">
    <chain base_link="t2_a1_base_link" tip_link="t2_a1_wrist_3_link"/>
  </group>
  <group name="t2_a2_arm">
    <chain base_link="t2_a2_base_link" tip_link="t2_a2_wrist_3_link"/>
  </group>

  <!-- End Effectors -->
  <end_effector name="t1_a1_gripper" parent_link="t1_a1_wrist_3_link" group="t1_a1_arm">
    <component name="t1_a1_gripper_component" link="t1_a1_gripper_base_link"/>
  </end_effector>
  <end_effector name="t1_a2_gripper" parent_link="t1_a2_wrist_3_link" group="t1_a2_arm">
    <component name="t1_a2_gripper_component" link="t1_a2_gripper_base_link"/>
  </end_effector>
  <end_effector name="t2_a1_gripper" parent_link="t2_a1_wrist_3_link" group="t2_a1_arm">
    <component name="t2_a1_gripper_component" link="t2_a1_gripper_base_link"/>
  </end_effector>
  <end_effector name="t2_a2_gripper" parent_link="t2_a2_wrist_3_link" group="t2_a2_arm">
    <component name="t2_a2_gripper_component" link="t2_a2_gripper_base_link"/>
  </end_effector>

  <!-- Optional: Passive joints -->
  <passive_joint name="t1_a1_gripper_finger_joint"/>
  <passive_joint name="t1_a2_gripper_finger_joint"/>
  <passive_joint name="t2_a1_gripper_finger_joint"/>
  <passive_joint name="t2_a2_gripper_finger_joint"/>

  <!-- Optional: Disable collisions between tables -->
  <disabled_collisions>
    <pair link1="t1_base_link" link2="t2_base_link"/>
  </disabled_collisions>

</robot>
