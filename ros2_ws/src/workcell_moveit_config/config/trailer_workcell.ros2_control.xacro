                <state_interface name="position">
                  <param name="initial_value">${initial_positions['t1_rotation_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="t2_linear_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['t2_linear_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="t2_rotation_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['t2_rotation_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
