            </joint>
            <joint name="t1_a2_right_finger_bottom_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['t1_a2_right_finger_bottom_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="t2_a1_right_finger_bottom_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['t2_a1_right_finger_bottom_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="t2_a2_right_finger_bottom_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['t2_a2_right_finger_bottom_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="t1_linear_joint">
