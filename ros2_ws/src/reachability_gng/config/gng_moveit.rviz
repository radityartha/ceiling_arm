        t2_rotation_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      MoveIt_Planning_Group: gantry_1_with_arm_1
      Robot Description: robot_description
      Planning Scene Topic: monitored_planning_scene
      Planned Path:
        Loop Animation: true
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
        Links:
            t2_a1_arm_link:
              Value: false
            t2_a1_base_link:
              Value: false
            t2_a1_dummy_link:
              Value: false
            t2_a1_end_effector_link:
              Value: false
            t2_a1_forearm_link:
