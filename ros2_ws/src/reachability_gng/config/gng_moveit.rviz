              Value: false
            t2_a2_left_finger_prox_link:
              Value: false
            t2_a2_lower_wrist_link:
              Value: false
            t2_a2_right_finger_dist_link:
              Value: false
            t2_a2_right_finger_prox_link:
              Value: false
            t2_a2_shoulder_link:
              Value: false
            t2_a2_tool_frame:
              Value: false
            t2_a2_upper_wrist_link:
              Value: false
            t2_base_link:
              Value: false
            t2_mount_plate_left:
              Value: false
            t2_mount_plate_right:
              Value: false
            t2_platform_link:
              Value: false
            t2_rotation_link:
              Value: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: GNG arm_1 (green)
      Enabled: true
      Topic:
        Value: /gng_arm1/gng_markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: GNG arm_2 (orange)
      Enabled: true
      Topic:
        Value: /gng_arm2/gng_markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected objects
      Enabled: true
      Topic:
        Value: /detected_objects/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Reachability (green=reach/red=out)
      Enabled: true
      Topic:
        Value: /reachability/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Reachability voxels (+ % reachable)
      Enabled: true
      Topic:
        Value: /reachability/voxels
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Depth cloud cam1 (seg)
      Enabled: true
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Topic:
        Value: /rgbd/seg_cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Depth cloud cam2 (seg)
      Enabled: true
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Topic:
        Value: /rgbd2/seg_cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.0
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 1.5
      Pitch: 0.4
      Yaw: 0.8
      Target Frame: world
Window Geometry:
  Height: 900
  Width: 1400
