              Value: false
            t2_a2_forearm_link:
              Value: false
            t2_a2_gripper_base_link:
              Value: false
            t2_a2_left_finger_dist_link:
              Value: false
            t2_a2_left_finger_prox_link:
              Value: false
            t2_a2_lower_wrist_link:
              Value: false
            t2_a2_right_finger_dist_link:
              Value: false
            t2_a2_right_finger_prox_link:
              Value: false
            t2_a2_shoulder_link:
              Value: false
            t2_a2_tool_frame:
              Value: false
            t2_a2_upper_wrist_link:
              Value: false
            t2_base_link:
              Value: false
            t2_mount_plate_left:
              Value: false
            t2_mount_plate_right:
              Value: false
            t2_platform_link:
              Value: false
            t2_rotation_link:
              Value: false
      Scene Geometry:
        Scene Alpha: 1
        Scene Color: 50; 230; 50
        Show Scene Geometry: true
        Voxel Rendering: Occupied Voxels
        Voxel Coloring: Z-Axis
      Scene Robot:
        Robot Alpha: 0.5
        Links:
            t2_a1_arm_link:
              Value: false
            t2_a1_base_link:
              Value: false
            t2_a1_dummy_link:
              Value: false
            t2_a1_end_effector_link:
              Value: false
            t2_a1_forearm_link:
              Value: false
            t2_a1_gripper_base_link:
              Value: false
            t2_a1_left_finger_dist_link:
              Value: false
            t2_a1_left_finger_prox_link:
              Value: false
            t2_a1_lower_wrist_link:
              Value: false
            t2_a1_right_finger_dist_link:
              Value: false
            t2_a1_right_finger_prox_link:
              Value: false
            t2_a1_shoulder_link:
              Value: false
            t2_a1_tool_frame:
              Value: false
            t2_a1_upper_wrist_link:
              Value: false
