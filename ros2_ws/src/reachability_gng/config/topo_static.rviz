Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Reference Frame: world
    - Class: rviz_default_plugins/MarkerArray
      Name: TopoStatic
      Enabled: true
      Topic:
        Value: /topo_map/static/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: world
    Background Color: 30; 30; 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Focal Point:
        X: 2.5
        Y: 1.5
        Z: 1.0
      Pitch: 0.6
      Yaw: 2.3
Window Geometry:
  Height: 780
  Width: 1240
