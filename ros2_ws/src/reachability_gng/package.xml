<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachability_gng</name>
  <version>0.0.1</version>
  <description>
    Growing Neural Gas (GNG) reachability + capability map for the redundant
    arm+table system (arm_1 + table_1, 8 DOF). Learns a topological map from
    forward-kinematics samples and serves joint-configuration seeds to MoveIt IK.
  </description>

  <maintainer email="raditya.artha@gmail.com">Raditya</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- FK backend for offline data generation (pick one):
       pinocchio (recommended) or PyKDL (no extra dep). -->
  <exec_depend>python3-pinocchio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
