<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachability_gng</name>
  <version>0.0.1</version>
  <description>
    Growing Neural Gas (GNG) reachability + capability map for the redundant
    arm+table system (arm_1 + gantry_1, 8 DOF). Learns a topological map from
    forward-kinematics samples and serves joint-configuration seeds to MoveIt IK.
  </description>

  <maintainer email="raditya.artha@gmail.com">Raditya</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- object_localizer perception node -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <!-- extrinsics_view.launch.py expands the workcell URDF (for the gantry
       base frames the camera frames get judged against) and runs RViz. -->
  <exec_depend>workcell_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- realsense_dual.launch.py: physical RGBD camera bringup -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <!-- FK backend for offline data generation (pick one):
       pinocchio (recommended) or PyKDL (no extra dep). -->
  <exec_depend>python3-pinocchio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
