<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cell_gng</name>
  <version>0.1.0</version>
  <description>
    GNG-U2-style topological mapping node for the ceiling-robot workcell.
    Consumes a sensor_msgs/PointCloud2 (sim LiDAR or, later, the real Mid360)
    and builds a growing topological network published as a MarkerArray.
    Includes a sim-only ground-truth validation harness.
  </description>
  <maintainer email="raditya.artha@gmail.com">radityartha</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>

  <!-- For the sim sandbox launch (optional include of the sim + bridge) -->
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
